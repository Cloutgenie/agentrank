# Database (backend only)
DATABASE_URL=postgresql+psycopg://edgeslate:edgeslate@localhost:5432/edgeslate

# The Odds API — https://the-odds-api.com
# Required for LIVE picks on Vercel. Set this exact name (no quotes around the value):
ODDS_API_KEY=

# Optional
BALLDONTLIE_API_KEY=
KALSHI_API_KEY=
POLYMARKET_ENABLED=true

# Backend knobs
EDGE_THRESHOLD_PP=2.0
MARKET_WEIGHT=0.70
ELO_WEIGHT=0.30
MONTE_CARLO_SIMS=10000
MAX_TEAM_EXPOSURE=3
ENABLE_SCHEDULER=false
USE_DEMO_DATA=false

# CORS / local frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave empty on Vercel so the app uses same-origin /api routes
NEXT_PUBLIC_API_URL=
