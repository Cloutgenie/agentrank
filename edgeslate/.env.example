# Database
DATABASE_URL=postgresql+psycopg://edgeslate:edgeslate@localhost:5432/edgeslate

# The Odds API — https://the-odds-api.com (free tier)
ODDS_API_KEY=

# BallDontLie — https://www.balldontlie.io (free tier)
BALLDONTLIE_API_KEY=

# Optional prediction-market keys (public endpoints work without keys for Polymarket)
KALSHI_API_KEY=
POLYMARKET_ENABLED=true

# Model / product knobs
EDGE_THRESHOLD_PP=2.0
MARKET_WEIGHT=0.70
ELO_WEIGHT=0.30
MONTE_CARLO_SIMS=10000
MAX_TEAM_EXPOSURE=3
ENABLE_SCHEDULER=false
USE_DEMO_DATA=true

# CORS / frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
